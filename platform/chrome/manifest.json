{
  "manifest_version": 3,
  "name": "Keyboard Layout Fixer (EN ⇄ FA)",
  "version": "1.3.1",
  "description": "Right-click a text box to fix text typed with the wrong keyboard layout (English ⇄ Persian).",
  "author": {
    "email": "ehsan.shariaty@gmail.com"
  },
  "homepage_url": "https://grizzly.ir",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Fix keyboard layout",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "minimum_chrome_version": "102",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}